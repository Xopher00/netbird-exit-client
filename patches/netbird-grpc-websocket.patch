+
+func webSocketDialer(tlsEnabled bool, component string) func(context.Context, string) (net.Conn, error) {
+	scheme := "ws"
+	if tlsEnabled {
+		scheme = "wss"
+	}
+	certPool, err := x509.SystemCertPool()
+	if err != nil || certPool == nil {
+		certPool = embeddedroots.Get()
+	}
+	// nbnet's dialer protects the socket on Android, so the control connection never runs inside the tunnel it controls.
+	nbDialer := nbnet.NewDialer()
+	httpClient := &http.Client{Transport: &http.Transport{
+		DialContext:     nbDialer.DialContext,
+		TLSClientConfig: &tls.Config{RootCAs: certPool},
+	}}
+	return func(ctx context.Context, addr string) (net.Conn, error) {
+		c, _, err := websocket.Dial(ctx, scheme+"://"+addr+wsproxy.ProxyPath+component, &websocket.DialOptions{HTTPClient: httpClient})
+		if err != nil {
+			return nil, fmt.Errorf("websocket dial: %w", err)
+		}
+		c.SetReadLimit(-1)
+		log.Infof("gRPC to %s goes through a WebSocket", addr)
+		// The connection outlives the dial's 30 s timeout context.
+		return websocket.NetConn(context.Background(), c, websocket.MessageBinary), nil
+	}
+}
