+// Candidates travel on the signal stream while offers and answers are handled on the handshaker's goroutine, so a
+// remote candidate can arrive before its agent exists, or while the agent it is about to replace still runs. Each
+// new agent gets the candidates of the last few seconds; one from an abandoned round only adds a pair that fails.
+const (
+	recentCandidateTTL  = 5 * time.Second
+	maxRecentCandidates = 64
+)
+
+type recentCandidate struct {
+	candidate ice.Candidate
+	received  time.Time
+	used      bool
+}
