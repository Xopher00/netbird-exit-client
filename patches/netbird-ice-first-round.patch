+}
+
+// pruneRecentCandidates drops expired entries. Caller must hold muxAgent.
+func (w *WorkerICE) pruneRecentCandidates() {
+	now := time.Now()
+	kept := w.recentCandidates[:0]
+	unused := 0
+	for _, r := range w.recentCandidates {
+		switch {
+		case now.Sub(r.received) <= recentCandidateTTL:
+			kept = append(kept, r)
+		case !r.used:
+			unused++
+		}
+	}
+	w.recentCandidates = kept
+	if unused > 0 {
+		w.log.Infof("dropped %d remote candidates that no ICE agent received within %s", unused, recentCandidateTTL)
+	}
+}
+
+// keepRecentCandidate stores the candidate; when full, the oldest goes. Caller must hold muxAgent.
+func (w *WorkerICE) keepRecentCandidate(candidate ice.Candidate, used bool) {
+	w.pruneRecentCandidates()
+	if len(w.recentCandidates) == maxRecentCandidates {
+		w.log.Debugf("more than %d remote candidates in %s, dropping the oldest", maxRecentCandidates, recentCandidateTTL)
+		w.recentCandidates = append(w.recentCandidates[:0], w.recentCandidates[1:]...)
+	}
+	w.recentCandidates = append(w.recentCandidates, recentCandidate{candidate: candidate, received: time.Now(), used: used})
+}
+
+// addRecentCandidates gives a new agent the remote candidates that are still fresh. Caller must hold muxAgent.
+func (w *WorkerICE) addRecentCandidates(agent *icemaker.ThreadSafeAgent) {
+	w.pruneRecentCandidates()
+	for i := range w.recentCandidates {
+		w.addRemoteCandidate(agent, w.recentCandidates[i].candidate)
+		w.recentCandidates[i].used = true
+	}
+	if n := len(w.recentCandidates); n > 0 {
+		w.log.Infof("gave the new ICE agent %d remote candidates received in the last %s", n, recentCandidateTTL)
+	}
+}
